<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Registration flow shell (GenericController). Same fx:ids / node types as before:
     row 0 page title (navigationAnchorPane), row 1 content card (anchorPane, hosts the step TabPane),
     row 2 action bar (footerGridPane: status message left, primary action right). -->
<GridPane fx:id="genericScreen" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1530.0" prefWidth="800.0" styleClass="parentPane, registrationShell" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.GenericController">
   <rowConstraints>
      <RowConstraints percentHeight="7.0" valignment="CENTER" />
      <RowConstraints percentHeight="85.0" />
      <RowConstraints percentHeight="8.0" valignment="CENTER" />
   </rowConstraints>
   <columnConstraints>
      <ColumnConstraints percentWidth="100.0" />
   </columnConstraints>
   <children>
      <AnchorPane fx:id="navigationAnchorPane" styleClass="registrationTitleBar" GridPane.rowIndex="0" />
      <AnchorPane fx:id="anchorPane" prefHeight="500.0" prefWidth="500.0" styleClass="paneAtDisplayDemoGraphic, registrationCard" GridPane.rowIndex="1" />
      <GridPane fx:id="footerGridPane" alignment="CENTER_LEFT" styleClass="registrationActionBar" GridPane.rowIndex="2">
         <columnConstraints>
            <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" />
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints valignment="CENTER" vgrow="ALWAYS" />
         </rowConstraints>
         <children>
            <Label fx:id="notification" alignment="CENTER_LEFT" mnemonicParsing="false" styleClass="registrationErrorMsg" wrapText="true" GridPane.hgrow="ALWAYS" />
            <Button fx:id="next" mnemonicParsing="false" styleClass="contiuneButton" text="%continue" GridPane.columnIndex="1" />
            <Button fx:id="authenticate" mnemonicParsing="false" styleClass="contiuneButton" text="%authenticate" GridPane.columnIndex="1" />
         </children>
      </GridPane>
   </children>
</GridPane>
