<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Operator onboarding / "Update operator biometrics" capture (BiometricsController), shown under the app bar of
     Onboard.fxml. Page template: breadcrumb + title (subTypeLabel, set by the controller), one card with the modality
     rail (leftPanelImageGridPane, filled by the controller), the capture panel with the quality bar (retryBox) and the
     exceptions column (checkBoxPane), and the action bar (back / save). Same fx:ids, node types and handlers as before;
     only the unused legacy tracker nodes were removed. gheaderfooter is the legacy registration header and is hidden
     for onboarding by the controller. -->
<GridPane fx:id="biometric" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" styleClass="onboardBiometricPage" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.device.BiometricsController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints vgrow="NEVER" />
    <RowConstraints minHeight="88.0" vgrow="NEVER" />
    <RowConstraints minHeight="10.0" vgrow="ALWAYS" />
    <RowConstraints minHeight="64.0" vgrow="NEVER" />
  </rowConstraints>
   <children>
      <GridPane fx:id="gheaderfooter" managed="${gheaderfooter.visible}" styleClass="headerFooter">
         <children>
            <HBox alignment="CENTER" spacing="5.0" styleClass="homeBox" GridPane.rowIndex="1">
               <children>
                  <Button mnemonicParsing="false" onAction="#goToHomePageFromRegistration" styleClass="homeButton" text="%home" />
                  <Label fx:id="registrationNavlabel" styleClass="headerLabel" text="%/registration" />
               </children>
            </HBox>
            <GridPane alignment="CENTER" styleClass="headerPageTracker" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.halignment="LEFT" GridPane.valignment="CENTER">
                     <children>
                        <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/activeDemographicDetails.png" />
                           </image>
                        </ImageView>
                        <Label styleClass="headerTexts" text="%demograhpicDetails" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="2">
                     <children>
                        <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/activeUploadDocument.png" />
                           </image>
                        </ImageView>
                        <Label alignment="BOTTOM_CENTER" contentDisplay="TOP" styleClass="headerTexts" text="%uploadDocuments" />
                     </children>
                  </HBox>
                  <HBox fx:id="trackerHolder" alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="4">
                     <children>
                        <ImageView fitHeight="18.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/activeBiometricDetail.png" />
                           </image>
                        </ImageView>
                        <Label alignment="CENTER" contentDisplay="TOP" minWidth="${trackerHolder.width/1.5}" styleClass="trackerHighlighter" text="%biometricDetails" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="6">
                     <children>
                        <ImageView fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/deactiveAuthentication.png" />
                           </image>
                        </ImageView>
                        <Label alignment="BOTTOM_CENTER" styleClass="headerTexts" text="%authentication" />
                     </children>
                  </HBox>
               </children>
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="5.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="5.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="5.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="25.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="SOMETIMES" />
               </rowConstraints>
            </GridPane>
         </children>
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="15.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="75.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="10.0" prefWidth="100.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" percentHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" percentHeight="70.0" prefHeight="30.0" vgrow="SOMETIMES" />
         </rowConstraints>
      </GridPane>

      <HBox alignment="CENTER_LEFT" styleClass="pageHeader" GridPane.rowIndex="1">
         <children>
            <VBox alignment="CENTER_LEFT" styleClass="pageHeaderTitles">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="breadcrumb">
                     <children>
                        <Button mnemonicParsing="false" onAction="#goToHomePageFromOnboard" styleClass="homeButton" text="%home" />
                        <Label styleClass="headerLabel" text="/" />
                        <Label fx:id="onboardBreadcrumbCurrent" styleClass="headerLabel" />
                     </children>
                  </HBox>
                  <Label fx:id="subTypeLabel" styleClass="mainHeader" />
               </children>
            </VBox>
         </children>
      </HBox>

      <GridPane styleClass="pageBody" GridPane.rowIndex="2">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <HBox styleClass="contentCard, onboardBiometricCard">
               <children>
                  <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="-Infinity" styleClass="onboardModalityRail">
                     <content>
                        <GridPane fx:id="leftPanelImageGridPane">
                          <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints maxHeight="0.0" minHeight="0.0" prefHeight="0.0" vgrow="NEVER" />
                            <RowConstraints vgrow="NEVER" />
                          </rowConstraints>
                        </GridPane>
                     </content>
                  </ScrollPane>
                  <VBox alignment="TOP_CENTER" styleClass="onboardCapturePanel" HBox.hgrow="ALWAYS">
                     <children>
                        <GridPane fx:id="biometricBox" styleClass="onboardCaptureGrid">
                          <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="10.0" />
                            <ColumnConstraints hgrow="NEVER" minWidth="-Infinity" />
                          </columnConstraints>
                          <rowConstraints>
                            <RowConstraints vgrow="NEVER" />
                            <RowConstraints valignment="TOP" vgrow="ALWAYS" />
                          </rowConstraints>
                           <children>
                              <Label fx:id="biometricType" styleClass="onboardModalityTitle" GridPane.halignment="LEFT" GridPane.columnSpan="2" />
                              <VBox alignment="TOP_CENTER" styleClass="onboardCaptureColumn" GridPane.rowIndex="1">
                                 <children>
                                    <GridPane fx:id="biometricPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="260.0" prefWidth="300.0" styleClass="biometricPaneSelected">
                                       <children>
                                          <ImageView fx:id="biometricImage" fitHeight="${biometricPane.height-24}" fitWidth="${biometricPane.width-24}" pickOnBounds="true" preserveRatio="true" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" percentWidth="100.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" percentHeight="100.0" valignment="CENTER" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                    </GridPane>
                                    <Button fx:id="scanBtn" mnemonicParsing="false" onAction="#scan" styleClass="onboardScanBtn" text="%scan">
                                       <graphic>
                                          <ImageView fx:id="scanImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@../images/scan.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Button>
                                    <!-- per-attempt numbers; the quality bar below already shows threshold and quality -->
                                    <GridPane fx:id="thresholdBox" managed="false" visible="false">
                                       <children>
                                          <Label fx:id="attemptsLabel1" styleClass="attemptsLabel" text="%attempts" />
                                          <Label fx:id="exceptionsLabel" styleClass="exceptionLabel" text="%exceptions" GridPane.columnIndex="1" />
                                          <Label fx:id="thresholdScoreLabel" GridPane.rowIndex="1" />
                                          <Label fx:id="qualityScore" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                          <Label fx:id="attemptSlap" GridPane.rowIndex="2" />
                                       </children>
                                    </GridPane>
                                 </children>
                              </VBox>
                              <VBox styleClass="onboardExceptionColumn" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <GridPane fx:id="checkBoxPane" />
                                    <Label fx:id="photoAlert" styleClass="photoAlert" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                        <GridPane fx:id="retryBox" maxWidth="720.0" styleClass="dividerTypeTwo, onboardQualityPanel">
                           <children>
                              <GridPane fx:id="parentProgressPane" hgap="16.0" vgap="6.0">
                                 <children>
                                    <Label fx:id="thresholdLabel" maxWidth="Infinity" text="%threshold" GridPane.columnIndex="1" />
                                    <Label styleClass="qualityLabel" text="%quality" GridPane.rowIndex="1" />
                                    <ProgressBar fx:id="bioProgress" maxWidth="Infinity" progress="0.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <GridPane maxWidth="Infinity" mouseTransparent="true" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                       <children>
                                          <AnchorPane fx:id="thresholdBar" />
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints fx:id="thresholdPane1" hgrow="SOMETIMES" percentWidth="10.0" />
                                          <ColumnConstraints fx:id="thresholdPane2" hgrow="SOMETIMES" percentWidth="90.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                    </GridPane>
                                    <Label fx:id="qualityText" alignment="CENTER_LEFT" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Label fx:id="attemptsLabel" managed="${attemptsLabel.visible}" styleClass="attemptsLabel" text="%attempts" GridPane.rowIndex="2" />
                                    <HBox fx:id="bioRetryBox" managed="${bioRetryBox.visible}" spacing="12.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                 </children>
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER" minWidth="96.0" prefWidth="96.0" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                    <ColumnConstraints hgrow="NEVER" minWidth="72.0" prefWidth="72.0" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints vgrow="NEVER" />
                                    <RowConstraints minHeight="30.0" vgrow="NEVER" />
                                    <RowConstraints vgrow="NEVER" />
                                 </rowConstraints>
                              </GridPane>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints vgrow="NEVER" />
                           </rowConstraints>
                        </GridPane>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" styleClass="headerFooter, pageActionBar" GridPane.rowIndex="3">
         <children>
            <GridPane fx:id="backButton" managed="${backButton.visible}">
               <children>
                  <Button fx:id="backBtn" mnemonicParsing="false" onAction="#previous" styleClass="backButton" text="%back" GridPane.valignment="TOP">
                     <graphic>
                        <ImageView fx:id="backImageView" fitHeight="20.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/arrowLeft.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
            </GridPane>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="continueBtn" mnemonicParsing="false" onAction="#next" styleClass="contiuneButton" text="%continue">
               <graphic>
                  <ImageView fx:id="rightArrowImgView" fitHeight="20.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/arrowRight.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
</GridPane>
