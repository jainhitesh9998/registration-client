<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>

<!-- Application upload (PacketUploadController). Page template: app bar, page header (breadcrumb + title +
     save/upload), table card with a filter toolbar, note bar. Same fx:ids / handlers / node types as before. -->
<GridPane fx:id="uploadPacketRoot" prefHeight="600.0" prefWidth="800.0" styleClass="uploadPacketparentPane, parentPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.reg.PacketUploadController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
  </rowConstraints>
   <children>
      <GridPane fx:id="packetUploadPane">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints percentHeight="5.5" vgrow="NEVER" />
          <RowConstraints percentHeight="10.0" valignment="CENTER" vgrow="NEVER" />
          <RowConstraints percentHeight="77.5" vgrow="ALWAYS" />
          <RowConstraints percentHeight="7.0" valignment="CENTER" vgrow="NEVER" />
        </rowConstraints>
         <children>
            <GridPane fx:id="header">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <fx:include fx:id="Header" prefHeight="${header.height}" prefWidth="${header.width}" source="Header.fxml" />
               </children>
            </GridPane>

            <GridPane fx:id="uploadPacketHeader" styleClass="pageHeaderGrid" GridPane.rowIndex="1">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints hgrow="NEVER" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints valignment="CENTER" vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <VBox alignment="CENTER_LEFT" styleClass="pageHeaderTitles">
                     <children>
                        <HBox alignment="CENTER_LEFT" styleClass="breadcrumb">
                           <children>
                              <Button mnemonicParsing="false" onAction="#goToHomePacketUpload" styleClass="homeButton" text="%home" />
                              <Label styleClass="headerLabel" text="%/uploadpacket" />
                           </children>
                        </HBox>
                        <Label styleClass="mainHeader" text="%uploadpacket" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" styleClass="pageHeaderActions" GridPane.columnIndex="1">
                     <children>
                        <Button fx:id="saveToDevice" mnemonicParsing="false" onAction="#packetExport" styleClass="backButton" text="%saveToDevice" />
                        <Button fx:id="uploadBtn" mnemonicParsing="false" onAction="#syncAndUploadPacket" styleClass="contiuneButton" text="%upload" />
                     </children>
                  </HBox>
               </children>
            </GridPane>

            <GridPane styleClass="pageBody" GridPane.rowIndex="2">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <GridPane fx:id="tableContainer" styleClass="contentCard" vgap="16.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints vgrow="NEVER" />
                      <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <TextField fx:id="filterField" promptText="%searchAppIDOpId" styleClass="searchBoxTextStyle" HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="clientStatusComboBox" promptText="%clientStatus" styleClass="filterCombobox" />
                              <ComboBox fx:id="serverStatusComboBox" promptText="%serverStatus" styleClass="filterCombobox" />
                              <Button fx:id="clearFilters" mnemonicParsing="false" styleClass="backButton" text="%clearFilters" />
                              <StackPane styleClass="iconButton">
                                 <children>
                                    <ImageView fx:id="exportCSVIcon" fitHeight="24.0" fitWidth="24.0" onMouseClicked="#exportData" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/export-icon.jpg" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                        <TableView fx:id="table" GridPane.rowIndex="1">
                           <columns>
                              <TableColumn fx:id="checkBoxColumn" prefWidth="${tableContainer.width*5/100}">
                                 <graphic>
                                    <CheckBox fx:id="selectAllCheckBox" mnemonicParsing="false" onAction="#selectAllCheckBox" styleClass="uploadCheckBox" />
                                 </graphic>
                              </TableColumn>
                              <TableColumn fx:id="slno" editable="false" prefWidth="${tableContainer.width*5/100}" resizable="false" sortable="false" styleClass="tableId" text="%slno" />
                              <TableColumn fx:id="fileNameColumn" editable="false" prefWidth="${tableContainer.width*25/100}" resizable="false" styleClass="tableId" text="%applicationId" />
                              <TableColumn fx:id="regDate" editable="false" prefWidth="${tableContainer.width*16/100}" resizable="false" styleClass="tableId" text="%registrationDate" />
                              <TableColumn fx:id="regType" editable="false" prefWidth="${tableContainer.width*11/100}" resizable="false" styleClass="tableId" text="%registrationType" />
                              <TableColumn fx:id="clientStatus" editable="false" prefWidth="${tableContainer.width*12/100}" resizable="false" styleClass="tableId" text="%clientStatus" />
                              <TableColumn fx:id="serverStatus" editable="false" prefWidth="${tableContainer.width*12/100}" resizable="false" styleClass="tableId" text="%serverStatus" />
                              <TableColumn fx:id="operatorId" editable="false" prefWidth="${tableContainer.width*12/100}" resizable="false" styleClass="tableId" text="%operatorId" />
                           </columns>
                        </TableView>
                        <StackPane fx:id="progressIndicatorPane" visible="false" GridPane.rowIndex="1">
                           <children>
                              <ProgressIndicator fx:id="progressIndicator" maxHeight="64.0" maxWidth="64.0" progress="0.0" />
                           </children>
                        </StackPane>
                     </children>
                  </GridPane>
               </children>
            </GridPane>

            <HBox alignment="CENTER_LEFT" styleClass="pageActionBar" GridPane.rowIndex="3">
               <children>
                  <Label styleClass="pageActionBarNote" text="%saveToDeviceLable" wrapText="true" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </children>
</GridPane>
