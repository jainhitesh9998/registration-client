<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Update UIN, first step (UpdateUINController): app bar, page header (breadcrumb + title from the process spec),
     a card with the UIN field and the field groups to update (option cards, in process-spec order) and the action bar.
     Same fx:ids / node types / handlers as before; backBtn is the breadcrumb's Home link. -->
<GridPane fx:id="uinUpdateRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="updateUinparentPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.reg.UpdateUINController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="5.5" vgrow="NEVER" />
    <RowConstraints percentHeight="10.0" valignment="CENTER" vgrow="NEVER" />
    <RowConstraints percentHeight="77.5" vgrow="ALWAYS" />
    <RowConstraints percentHeight="7.0" valignment="CENTER" vgrow="NEVER" />
  </rowConstraints>
   <children>
      <GridPane fx:id="header">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <fx:include fx:id="headerParentBorder" prefHeight="${header.height}" prefWidth="${header.width}" source="Header.fxml" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" styleClass="pageHeader" GridPane.rowIndex="1">
         <children>
            <VBox alignment="CENTER_LEFT" styleClass="pageHeaderTitles">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="breadcrumb">
                     <children>
                        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#goToHome" styleClass="homeButton" text="%home">
                           <graphic>
                              <ImageView fx:id="backImageView" fitHeight="12.0" fitWidth="12.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false" />
                           </graphic>
                        </Button>
                        <Label fx:id="breadcrumbCurrent" styleClass="headerLabel" text="/ " />
                     </children>
                  </HBox>
                  <Label fx:id="pageTitle" styleClass="mainHeader" text="%uinupdate" />
               </children>
            </VBox>
         </children>
      </HBox>

      <GridPane styleClass="pageBody" GridPane.rowIndex="2">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <VBox styleClass="contentCard, uinUpdateContentPane, uinUpdateCard">
               <children>
                  <VBox styleClass="uinUpdateField">
                     <children>
                        <Label styleClass="uinUpdateLabels" text="%uin" />
                        <TextField fx:id="uinId" maxWidth="-Infinity" prefWidth="296.0" promptText="%uinno" styleClass="uinUpdateTextFiledStyle" />
                     </children>
                  </VBox>
                  <Label styleClass="uinUpdateLabels, uinUpdateSectionLabel" text="%selecttoupdate" />
                  <GridPane fx:id="contentGridPane" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                      <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" vgrow="ALWAYS" />
                    </rowConstraints>
                     <children>
                        <HBox fx:id="demographicHBox" styleClass="updateUinCheckBoxCommon">
                           <children>
                              <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="uinupdate-scroll-pane" HBox.hgrow="ALWAYS">
                                 <content>
                                    <FlowPane fx:id="parentFlowPane" hgap="12.0" vgap="12.0" />
                                 </content>
                              </ScrollPane>
                           </children>
                        </HBox>
                     </children>
                  </GridPane>
               </children>
            </VBox>
         </children>
      </GridPane>

      <HBox alignment="CENTER_RIGHT" styleClass="headerFooter, pageActionBar" GridPane.rowIndex="3">
         <children>
            <Button fx:id="continueBtn" mnemonicParsing="false" onAction="#submitUINUpdate" styleClass="contiuneButton" text="%continue">
               <graphic>
                  <ImageView fx:id="continueImageView" fitHeight="20.0" fitWidth="27.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/arrowRight.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
</GridPane>
