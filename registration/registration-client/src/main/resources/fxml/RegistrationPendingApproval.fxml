<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<!-- Pending approval (RegistrationApprovalController). Same fx:ids / node types / handlers as before:
     app bar, page header (breadcrumb + title + decision counts), two cards (applications list; review card with the
     selected application, its decision and approve/reject, acknowledgement preview) and an action bar
     (decided summary + guidance + authenticate). -->
<GridPane fx:id="eodRoot" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="parentPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.eodapproval.RegistrationApprovalController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="5.5" vgrow="NEVER" />
    <RowConstraints percentHeight="10.0" valignment="CENTER" vgrow="NEVER" />
    <RowConstraints percentHeight="77.5" vgrow="ALWAYS" />
    <RowConstraints percentHeight="7.0" valignment="CENTER" vgrow="NEVER" />
  </rowConstraints>
   <children>
      <GridPane fx:id="header">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <fx:include fx:id="headerParentBorder" prefHeight="${header.height}" prefWidth="${header.width}" source="Header.fxml" />
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" styleClass="pageHeader" GridPane.rowIndex="1">
         <children>
            <VBox alignment="CENTER_LEFT" styleClass="pageHeaderTitles">
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="breadcrumb">
                     <children>
                        <Button mnemonicParsing="false" onAction="#goToHomePageFromApproval" styleClass="homeButton" text="%home" />
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="headerLabel" text="%/pendingapproval" />
                     </children>
                  </HBox>
                  <Label styleClass="mainHeader" text="%pendingapproval" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="approvalStats" alignment="CENTER_RIGHT" fillHeight="false" styleClass="approvalStats">
               <children>
                  <HBox alignment="BASELINE_LEFT" styleClass="approvalStat">
                     <children>
                        <Label fx:id="pendingCountLbl" styleClass="approvalStatValue" text="0" />
                        <Label styleClass="approvalStatLabel" text="%approvalPending" />
                     </children>
                  </HBox>
                  <HBox alignment="BASELINE_LEFT" styleClass="approvalStat, approvalStatApproved">
                     <children>
                        <Label fx:id="approvedCountLbl" styleClass="approvalStatValue" text="0" />
                        <Label styleClass="approvalStatLabel" text="%approvalApproved" />
                     </children>
                  </HBox>
                  <HBox alignment="BASELINE_LEFT" styleClass="approvalStat, approvalStatRejected">
                     <children>
                        <Label fx:id="rejectedCountLbl" styleClass="approvalStatValue" text="0" />
                        <Label styleClass="approvalStatLabel" text="%approvalRejected" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </HBox>

      <GridPane fx:id="approveRegistrationRootSubPane" hgap="24.0" styleClass="approveRegistrationRootSubPane, pageBody" GridPane.rowIndex="2">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" percentWidth="44.0" />
          <ColumnConstraints hgrow="ALWAYS" percentWidth="56.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <GridPane fx:id="tableContainer" styleClass="contentCard" vgap="16.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="NEVER" />
                <RowConstraints vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <TextField fx:id="filterField" promptText="%searchApplication" styleClass="searchBoxTextStyle" HBox.hgrow="ALWAYS" />
                        <StackPane styleClass="iconButton">
                           <children>
                              <ImageView fx:id="exportImageView" fitHeight="24.0" fitWidth="24.0" onMouseClicked="#exportData" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/export-icon.jpg" />
                                 </image>
                              </ImageView>
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
                  <TableView fx:id="table" GridPane.rowIndex="1">
                    <columns>
                      <TableColumn fx:id="slno" editable="false" prefWidth="${tableContainer.width*7/100}" resizable="false" styleClass="tableId" text="%slno" />
                      <TableColumn fx:id="id" editable="false" prefWidth="${tableContainer.width*35/100}" resizable="false" styleClass="tableId" text="%applicationId" />
                      <TableColumn fx:id="date" editable="false" prefWidth="${tableContainer.width*22/100}" resizable="false" styleClass="tableId" text="%date" />
                      <TableColumn fx:id="acknowledgementFormPath" editable="false" text="%registrtionid" visible="false" />
                      <TableColumn fx:id="operatorId" editable="false" prefWidth="${tableContainer.width*14/100}" resizable="false" styleClass="tableId" text="%operatorId" />
                      <TableColumn fx:id="statusComment" editable="false" prefWidth="${tableContainer.width*17/100}" resizable="false" styleClass="pendingApprovalStatus" text="%approvalDecision" />
                    </columns>
                  </TableView>
               </children>
            </GridPane>
            <GridPane fx:id="imageAnchorPane" styleClass="imageAnchorPaneStyle, contentCard, reviewCard" GridPane.columnIndex="1">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="NEVER" />
                <RowConstraints minHeight="10.0" vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <HBox alignment="CENTER_LEFT" styleClass="reviewHeader">
                     <children>
                        <VBox alignment="CENTER_LEFT" styleClass="reviewHeaderTitles" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="reviewTitle" styleClass="reviewTitle" />
                              <Label fx:id="reviewMeta" styleClass="reviewMeta" />
                           </children>
                        </VBox>
                        <Label fx:id="reviewDecision" managed="${reviewDecision.visible}" styleClass="decisionPill" visible="false" />
                        <ToggleButton fx:id="rejectionBtn" mnemonicParsing="false" onAction="#updateStatus" styleClass="rejectButton" text="%reject">
                           <graphic>
                              <ImageView fx:id="rejectionImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/Reject.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="approvalBtn" mnemonicParsing="false" onAction="#updateStatus" styleClass="approveButton" text="%approve">
                           <graphic>
                              <ImageView fx:id="approvalImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/Approve.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                     </children>
                  </HBox>
                  <WebView fx:id="webView" prefHeight="-1.0" prefWidth="-1.0" GridPane.rowIndex="1" />
               </children>
            </GridPane>
         </children>
      </GridPane>

      <HBox alignment="CENTER_LEFT" styleClass="pendingApprovalFooter, pageActionBar" GridPane.rowIndex="3">
         <children>
            <VBox alignment="CENTER_LEFT" styleClass="pageActionBarText" HBox.hgrow="ALWAYS">
               <children>
                  <HBox fx:id="decisionSummaryLbl" styleClass="pageActionBarSummary" />
                  <Label styleClass="pageActionBarNote" text="%approved/rejected" wrapText="true" />
               </children>
            </VBox>
            <ToggleButton fx:id="authenticateBtn" mnemonicParsing="false" onAction="#updateStatus" styleClass="approveButton" text="%authenticate">
               <graphic>
                  <ImageView fx:id="authenticateImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/Authenticate.png" />
                     </image>
                  </ImageView>
               </graphic>
            </ToggleButton>
         </children>
      </HBox>
   </children>
</GridPane>
