<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.web.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<!-- Notification for re-registration (ReRegistrationController). Page template: app bar, page header
     (breadcrumb + title + informed / can't-inform), list and preview cards, action bar.
     Same fx:ids / handlers / toggle group / node types as before. -->
<GridPane fx:id="reRegistrationRootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="parentPane" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.eodapproval.ReRegistrationController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="5.5" vgrow="NEVER" />
    <RowConstraints percentHeight="94.5" vgrow="ALWAYS" />
  </rowConstraints>
   <children>
      <GridPane fx:id="header">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <fx:include fx:id="headerParentBorder" prefHeight="${header.height}" prefWidth="${header.width}" source="Header.fxml" />
         </children>
      </GridPane>
      <GridPane fx:id="reRegistrationChildPane" GridPane.rowIndex="1">
        <columnConstraints>
          <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints percentHeight="10.6" valignment="CENTER" vgrow="NEVER" />
          <RowConstraints percentHeight="82.0" vgrow="ALWAYS" />
          <RowConstraints percentHeight="7.4" valignment="CENTER" vgrow="NEVER" />
        </rowConstraints>
         <children>
            <HBox alignment="CENTER_LEFT" styleClass="pageHeader">
               <children>
                  <VBox alignment="CENTER_LEFT" styleClass="pageHeaderTitles">
                     <children>
                        <HBox alignment="CENTER_LEFT" styleClass="breadcrumb">
                           <children>
                              <Button mnemonicParsing="false" onAction="#goToHomePageFromReRegistration" styleClass="homeButton" text="%home" />
                              <Label styleClass="headerLabel" text="%/reRegistration" />
                           </children>
                        </HBox>
                        <Label styleClass="mainHeader" text="%reRegistration" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" styleClass="pageHeaderActions">
                     <children>
                        <ToggleButton fx:id="notInformedBtn" mnemonicParsing="false" onAction="#notInformedToUser" styleClass="reRegCantInformToggle" text="%cantinformed">
                           <graphic>
                              <ImageView fx:id="informedImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/informed.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                           <toggleGroup>
                              <ToggleGroup fx:id="informedStatus" />
                           </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="informedBtn" mnemonicParsing="false" onAction="#informedToUser" styleClass="reRegInformToggle" text="%informed" toggleGroup="$informedStatus">
                           <graphic>
                              <ImageView fx:id="cantInformImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../images/cantInform.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                     </children>
                  </HBox>
               </children>
            </HBox>

            <GridPane fx:id="approveRegistrationRootSubPane" hgap="24.0" styleClass="approveRegistrationRootSubPane, pageBody" GridPane.rowIndex="1">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="54.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="46.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  <GridPane fx:id="tableContainer" styleClass="contentCard" vgap="16.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints vgrow="NEVER" />
                      <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                           <children>
                              <TextField fx:id="filterField" promptText="%searchApplication" styleClass="searchBoxTextStyle" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="table" styleClass="approvalTable" GridPane.rowIndex="1">
                           <columns>
                              <TableColumn fx:id="slno" editable="false" prefWidth="${tableContainer.width*8/100}" resizable="false" styleClass="tableId" text="%slno" />
                              <TableColumn fx:id="id" editable="false" prefWidth="${tableContainer.width*40/100}" resizable="false" styleClass="tableId" text="%applicationId" />
                              <TableColumn fx:id="date" editable="false" prefWidth="${tableContainer.width*26/100}" resizable="false" styleClass="tableId" text="%eodDate" />
                              <TableColumn fx:id="status" editable="false" prefWidth="${tableContainer.width*22/100}" resizable="false" styleClass="pendingApprovalStatus" text="%status" />
                              <TableColumn fx:id="acknowledgementFormPath" text="%registrtionid" visible="false" />
                           </columns>
                        </TableView>
                     </children>
                  </GridPane>
                  <GridPane fx:id="imageAnchorPane" styleClass="imageAnchorPaneStyle, contentCard" GridPane.columnIndex="1">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <WebView fx:id="webView" prefHeight="-1.0" prefWidth="-1.0" />
                     </children>
                  </GridPane>
               </children>
            </GridPane>

            <HBox alignment="CENTER_LEFT" styleClass="pageActionBar" GridPane.rowIndex="2">
               <children>
                  <Label styleClass="pageActionBarNote" text="%aplicatoinactioned" wrapText="true" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="authenticateBtn" mnemonicParsing="false" onAction="#authenticateReregister" styleClass="approveButton" text="%authenticate">
                     <graphic>
                        <ImageView fx:id="authenticateImageView" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/Authenticate.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
      </GridPane>
   </children>
</GridPane>
