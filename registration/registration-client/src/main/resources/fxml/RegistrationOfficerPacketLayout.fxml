<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.GridPane?>

<!-- Home dashboard. All fx:ids / handlers are those of the previous layout (PacketHandlerController contract
     unchanged); sections are re-arranged: registration tasks first, then operational and end-of-day tasks. -->
<GridPane fx:id="homeContent" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="850.0" styleClass="homeContent" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.reg.PacketHandlerController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
  </rowConstraints>
   <children>
      <StackPane>
         <children>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="homeScroll">
               <content>
                  <VBox styleClass="homePage">
                     <children>
                  <GridPane fx:id="userOnboardMsg" managed="${userOnboardMessage.visible}" visible="${userOnboardMessage.visible}">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <HBox fx:id="userOnboardMessage" alignment="CENTER_LEFT" styleClass="homeBanner" visible="false">
                           <children>
                              <Label graphicTextGap="10.0" styleClass="onboardAlertMsg" text="%onboardAlertMsg" wrapText="true">
                                 <graphic>
                                    <ImageView fx:id="tickMarkImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/tick.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                                 <HBox.margin>
                                    <Insets />
                                 </HBox.margin>
                              </Label>
                           </children>
                           <GridPane.margin>
                              <Insets />
                           </GridPane.margin>
                        </HBox>
                     </children>
                  </GridPane>
                        <VBox styleClass="homeSection">
                           <children>
                              <Label styleClass="homeSectionTitle" text="%registrationTasks" />
                              <GridPane fx:id="registrationGridPane" hgap="16.0" vgap="16.0" />
                           </children>
                        </VBox>
                        <HBox styleClass="homeColumns">
                           <children>
                              <VBox maxWidth="Infinity" prefWidth="0.0" styleClass="homeSection" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="homeSectionTitle" text="%operationalTasks" />
                                    <VBox fx:id="vHolder" spacing="12.0">
                                       <children>
                        <GridPane styleClass="homeTile">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" percentHeight="98.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="1.0" percentHeight="2.0" prefHeight="1.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <GridPane fx:id="syncDataPane" onMouseClicked="#syncData" prefHeight="70.0" prefWidth="250.0">
                                <columnConstraints>
                                  <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                       <children>
                                          <ImageView fx:id="syncDataImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@../images/sync.png" />
                                             </image>
                                          </ImageView>
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" prefHeight="12.0" prefWidth="205.0" spacing="2.0">
                                             <children>
                                                <Label alignment="TOP_LEFT" contentDisplay="TOP" styleClass="operationalDetails" text="%lastsynctemp" wrapText="true" />
                                                <Label fx:id="lastSyncTime" styleClass="operationalDetails" />
                                             </children>
                                          </HBox>
                                          <Label styleClass="operationalTitle" text="%synchronizeData" wrapText="true" />
                                       </children>
                                    </VBox>
                                 </children>
                              </GridPane>
                              <GridPane fx:id="progressPane" GridPane.rowIndex="1">
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" percentWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints percentHeight="0.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <ProgressBar fx:id="syncProgressBar" minHeight="1.0" prefHeight="${progressPane.height}" prefWidth="${progressPane.width}" progress="0.0" />
                                 </children>
                              </GridPane>
                           </children>
                        </GridPane>
                        <GridPane fx:id="downloadPreRegDataPane" onMouseClicked="#downloadPreRegData" prefHeight="72.0" prefWidth="25.0" styleClass="homeTile">
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="downloadPreRegDataImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/DownloadPreRegData.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="3.0">
                                       <children>
                                          <Label fx:id="lastPreRegPacketDownloadedTime" styleClass="operationalDetails" wrapText="true" />
                                          <ImageView fx:id="inProgressImage" fitHeight="25.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true" />
                                       </children>
                                    </HBox>
                                    <Label styleClass="operationalTitle" text="%downloadPreregistrationData" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                        <GridPane fx:id="updateOperatorBiometricsPane" onMouseClicked="#onBoardUser" prefHeight="72.0" prefWidth="250.0" styleClass="homeTile">
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="updateOperatorBiometricsImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/UpdateOperatorBiometrics.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label fx:id="lastBiometricTime" styleClass="operationalDetails" wrapText="true" />
                                    <Label styleClass="operationalTitle" text="%updateOperatorBiometrics" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                        <GridPane fx:id="uploadPacketPane" layoutX="10.0" layoutY="212.0" onMouseClicked="#uploadPacketToServer" prefHeight="72.0" prefWidth="250.0" styleClass="homeTile">
                           <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="uploadPacketImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/UpdateOperatorBiometrics.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="operationalTitle" text="%uploadpacket" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                        <GridPane fx:id="centerRemapPane" layoutX="10.0" layoutY="312.0" onMouseClicked="#intiateRemapProcess" prefHeight="72.0" prefWidth="250.0" styleClass="homeTile">
                           <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="remapImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/sync.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="operationalTitle" text="%remap" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                        <GridPane fx:id="checkUpdatesPane" layoutX="10.0" layoutY="412.0" onMouseClicked="#hasUpdate" prefHeight="72.0" prefWidth="250.0" styleClass="homeTile">
                           <children>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="checkUpdatesImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/DownloadPreRegData.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label fx:id="checkUpdates" styleClass="operationalTitle" text="%checkUpdates" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="156.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                              <VBox maxWidth="Infinity" prefWidth="0.0" styleClass="homeSection" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="eodLabel" managed="${eodLabel.visible}" styleClass="homeSectionTitle" text="%endofDayProcesses" />
                                    <GridPane fx:id="eodProcessGridPane" managed="${eodProcessGridPane.visible}" vgap="12.0">
                                       <children>
                        <GridPane fx:id="eodApprovalPane" onMouseClicked="#approvePacket" styleClass="homeTile">
                           <children>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label fx:id="pendingApprovalCountLbl" styleClass="operationalDetails" text="%applications" wrapText="true" />
                                    <Label styleClass="operationalTitle" text="%pendingapproval" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="eodApprovalImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/PendingApproval.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="178.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                        <GridPane fx:id="reRegistrationPane" onMouseClicked="#loadReRegistrationScreen" styleClass="homeTile" GridPane.rowIndex="1">
                           <children>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label fx:id="reRegistrationCountLbl" styleClass="operationalDetails" text="%applications" wrapText="true" />
                                    <Label styleClass="operationalTitle" text="%reRegistration" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="reRegistrationImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/Re-Registration.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="178.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                        <GridPane fx:id="dashBoardPane" onMouseClicked="#viewDashBoard" styleClass="homeTile" GridPane.rowIndex="2">
                           <children>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="operationalTitle" text="%dashBoard" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <ImageView fx:id="viewReportsImageView" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../images/ViewReports.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                           </children>
                           <columnConstraints>
                              <ColumnConstraints halignment="CENTER" hgrow="NEVER" maxWidth="72.0" minWidth="72.0" prefWidth="72.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="178.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                        </GridPane>
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="ALWAYS" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints maxHeight="72.0" minHeight="72.0" prefHeight="72.0" vgrow="NEVER" />
                                          <RowConstraints maxHeight="72.0" minHeight="72.0" prefHeight="72.0" vgrow="NEVER" />
                                          <RowConstraints maxHeight="72.0" minHeight="72.0" prefHeight="72.0" vgrow="NEVER" />
                                       </rowConstraints>
                                    </GridPane>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
             <HBox id="footer-section">
                     <children>
                         <Label prefHeight="30.0" text="%regClientVersion" textAlignment="CENTER" />
                         <Label text=" : " />
                         <Label fx:id="versionValueLabel" textAlignment="CENTER" />
                     </children>
             </HBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            <ProgressIndicator fx:id="progressIndicator" maxHeight="64.0" maxWidth="64.0" progress="0.0" visible="false" />
         </children>
      </StackPane>
   </children>
</GridPane>
