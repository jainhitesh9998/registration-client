<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- App bar (HeaderController). Brand + primary navigation on the left, connection status, settings, the
     signed-in user and the user menu on the right. All original fx:ids / handlers are kept; the centre and
     machine labels stay (hidden) because the controller still fills them; Home shows that context instead. -->
<GridPane fx:id="headerParent" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="56.0" prefWidth="1000.0" styleClass="headerParentBorder" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.reg.HeaderController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
  </rowConstraints>
   <children>
      <HBox alignment="CENTER_LEFT" styleClass="appBar">
         <children>
            <HBox alignment="CENTER_LEFT" styleClass="appBrand">
               <children>
                  <ImageView fx:id="mosipLogo" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/logo-final-small.png" />
                     </image>
                  </ImageView>
                  <Label styleClass="appBrandTitle" text="%regclient" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" styleClass="appNav">
               <children>
                  <Label onMouseClicked="#redirectHome" styleClass="appNavItem" text="%home" />
                  <Label fx:id="navEndOfDay" managed="${navEndOfDay.visible}" onMouseClicked="#openEndOfDay" styleClass="appNavItem" text="%endofDayProcesses" />
                  <Label onMouseClicked="#openUploadPacket" styleClass="appNavItem" text="%uploadpacket" />
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="settingsHBox" alignment="CENTER_RIGHT" spacing="16.0" />
            <StackPane styleClass="appStatus">
               <children>
                  <HBox fx:id="online" alignment="CENTER_LEFT" styleClass="appStatusItem">
                     <children>
                        <Region styleClass="statusDot, statusDotOnline" />
                        <Label styleClass="appStatusText" text="%homeOnline" />
                        <ImageView fx:id="availableIcon1" fitHeight="1.0" fitWidth="1.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false">
                           <image>
                              <Image url="@../images/Online.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
                  <HBox fx:id="offline" alignment="CENTER_LEFT" styleClass="appStatusItem">
                     <children>
                        <Region styleClass="statusDot, statusDotOffline" />
                        <Label styleClass="appStatusText" text="%homeOffline" />
                        <ImageView fx:id="availableIcon" fitHeight="1.0" fitWidth="1.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false">
                           <image>
                              <Image url="@../images/Offline.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <HBox fx:id="settingsIconHBox" alignment="CENTER" styleClass="appBarIconButton" visible="false">
               <children>
                  <ImageView fitHeight="20.0" fitWidth="20.0" onMouseClicked="#openSettings" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/settings.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
            <Label fx:id="registrationOfficerName" graphicTextGap="10.0" styleClass="appUserChip" text="%roname">
               <graphic>
                  <ImageView fx:id="userImageView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/User.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Label>
            <MenuBar fx:id="menu" styleClass="menuBar">
               <menus>
                  <Menu fx:id="homeSelectionMenu" mnemonicParsing="false" onAction="#closeOperations">
                     <graphic>
                        <ImageView fx:id="homeSelectionMenuImageView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/hamburger.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <items>
                        <MenuItem fx:id="userGuide" mnemonicParsing="false" onAction="#userGuide" text="%userGuide" />
                        <SeparatorMenuItem />
                        <MenuItem fx:id="resetPword" mnemonicParsing="false" onAction="#resetPword" text="%resetPassword" />
                        <SeparatorMenuItem />
                        <MenuItem fx:id="logout" mnemonicParsing="false" onAction="#logout" text="%logout" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <HBox managed="false" visible="false">
               <children>
                  <ImageView fx:id="homeImgView" fitHeight="1.0" fitWidth="1.0" onMousePressed="#redirectHome" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/Home-small.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="registrationOfficeLocation" text="%rooffice">
                     <graphic>
                        <ImageView fx:id="regCenterLocationImgView" fitHeight="1.0" fitWidth="1.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic>
                  </Label>
                  <Label fx:id="registrationOfficeId" text="%roid">
                     <graphic>
                        <ImageView fx:id="registrationOfficeIdImageView" fitHeight="1.0" fitWidth="1.0" pickOnBounds="true" preserveRatio="true" />
                     </graphic>
                  </Label>
               </children>
            </HBox>
         </children>
      </HBox>
   </children>
</GridPane>
