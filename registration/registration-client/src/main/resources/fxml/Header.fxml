<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- App bar. Same fx:ids / handlers as before (HeaderController contract unchanged); laid out as one flow:
     [logo][home] | [operator][centre][machine] ........ [shortcuts][online/offline][settings][menu] -->
<GridPane fx:id="headerParent" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="56.0" prefWidth="1000.0" styleClass="headerParentBorder" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.mosip.registration.controller.reg.HeaderController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints percentHeight="100.0" vgrow="ALWAYS" />
  </rowConstraints>
   <children>
      <HBox alignment="CENTER_LEFT" styleClass="appBar">
         <children>
            <ImageView fx:id="mosipLogo" fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/logo-final-small.png" />
               </image>
            </ImageView>
            <StackPane styleClass="appBarIconButton">
               <children>
                  <ImageView fx:id="homeImgView" fitHeight="22.0" fitWidth="22.0" onMousePressed="#redirectHome" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/Home-small.png" />
                     </image>
                  </ImageView>
               </children>
            </StackPane>
            <Region styleClass="appBarDivider" />
            <HBox alignment="CENTER_LEFT" styleClass="headerDetails">
               <children>
                  <Label fx:id="registrationOfficerName" graphicTextGap="8.0" styleClass="appBarChip" text="%roname">
                     <graphic>
                        <ImageView fx:id="userImageView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/User.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Label>
                  <Label fx:id="registrationOfficeLocation" graphicTextGap="8.0" styleClass="appBarChip" text="%rooffice">
                     <graphic>
                        <ImageView fx:id="regCenterLocationImgView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/RegCentreLocation.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Label>
                  <Label fx:id="registrationOfficeId" graphicTextGap="8.0" styleClass="appBarChip" text="%roid">
                     <graphic>
                        <ImageView fx:id="registrationOfficeIdImageView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/system.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Label>
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="settingsHBox" alignment="CENTER_RIGHT" spacing="16.0" />
            <StackPane styleClass="appBarIconButton">
               <children>
                  <HBox fx:id="online" alignment="CENTER">
                     <children>
                        <ImageView fx:id="availableIcon1" fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/Online.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
                  <HBox fx:id="offline" alignment="CENTER">
                     <children>
                        <ImageView fx:id="availableIcon" fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/Offline.png" />
                           </image>
                        </ImageView>
                     </children>
                  </HBox>
               </children>
            </StackPane>
            <HBox fx:id="settingsIconHBox" alignment="CENTER" styleClass="appBarIconButton" visible="false">
               <children>
                  <ImageView fitHeight="22.0" fitWidth="22.0" onMouseClicked="#openSettings" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/settings.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
            <MenuBar fx:id="menu" styleClass="menuBar">
               <menus>
                  <Menu fx:id="homeSelectionMenu" mnemonicParsing="false" onAction="#closeOperations">
                     <graphic>
                        <ImageView fx:id="homeSelectionMenuImageView" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/hamburger.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <items>
                        <MenuItem fx:id="userGuide" mnemonicParsing="false" onAction="#userGuide" text="%userGuide" />
                        <SeparatorMenuItem />
                        <MenuItem fx:id="resetPword" mnemonicParsing="false" onAction="#resetPword" text="%resetPassword" />
                        <SeparatorMenuItem />
                        <MenuItem fx:id="logout" mnemonicParsing="false" onAction="#logout" text="%logout" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
         </children>
      </HBox>
   </children>
</GridPane>
